{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jkeeper",
  "version": "0.1.0",
  "identifier": "com.jkeeper.manager",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "jkeeper",
